# Copia este ficheiro para .env.local e substitui pelos valores da app Web Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=coloca-aqui-a-apiKey
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nome-do-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nome-do-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nome-do-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=coloca-aqui-o-messagingSenderId
NEXT_PUBLIC_FIREBASE_APP_ID=coloca-aqui-o-appId
